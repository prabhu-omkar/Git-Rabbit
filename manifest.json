{
  "manifest_version": 3,
  "name": "Git-Rabbit",
  "short_name": "Git-Rabbit",
  "version": "1.0.0",
  "description": "Auto-sync competitive programming solutions to GitHub",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}